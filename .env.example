# Copy this file to .env and change the values.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret

# Leave DATABASE_URL commented to use SQLite at instance/inventory.db
# DATABASE_URL=postgresql://user:password@localhost:5432/stockflow

FLASK_DEBUG=True
COOKIE_SECURE=False

# ---- Stock-check alerts ----
# Background scan that creates "count this shelf" tasks for staff.
ALERT_SCHEDULER=True
ALERT_INTERVAL_MINUTES=60
ALERT_MAX_TASKS_PER_RUN=25
# Products with a risk score (0-100) at or above this get a check automatically
ALERT_RISK_THRESHOLD=60
# Move overdue high-priority checks to the next best person
AUTO_REASSIGN_OVERDUE=True

# ---- Optional e-mail notifications ----
# Leave MAIL_SERVER empty to use in-app notifications only.
# Gmail example: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, use an App Password.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
MAIL_FROM=
APP_BASE_URL=http://127.0.0.1:5000

# Time zone for dates in e-mails
DISPLAY_TIMEZONE=Asia/Kolkata

# Mailbox that gets a copy of every job assignment (and new staff).
ADMIN_EMAIL=t2064585@gmail.com
